{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["./_generated"]
}
