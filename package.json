{
  "name": "slander-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:launch": "node scripts/launch/dev.mjs",
    "build:launch": "tsc -p tsconfig.launch.json && vite build --config vite.launch.config.ts",
    "test:launch:planner": "node --test tests/launch/allocation-planner.test.ts",
    "test:launch:backend": "node --test --test-concurrency=1 tests/launch/allocation-preview.test.ts tests/launch/campaign-setup.test.ts tests/launch/creator-access.test.ts tests/launch/photos.test.ts",
    "test:launch:browser": "npm run build:launch && playwright test --config playwright.launch.config.ts",
    "test:launch": "npm run test:launch:planner && npm run test:launch:backend && npm run test:launch:browser",
    "dev:adoption": "vite --config vite.public.config.ts --mode public --base / --host 127.0.0.1 --port 5173 --strictPort",
    "dev": "node server/index.js --dev",
    "dev:kindred": "vite --config vite.public.config.ts --mode public --base / --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && node scripts/build-public.mjs",
    "stage:public": "node scripts/stage-public.mjs",
    "test:public": "npm run build:public && playwright test --config playwright.public.config.ts",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write src server tests *.json *.ts index.html README.md docs/DEMO.md",
    "format:check": "prettier --check src server tests *.json *.ts index.html README.md docs/DEMO.md"
  },
  "dependencies": {
    "@clerk/react": "^6.18.6",
    "@noble/hashes": "^2.4.0",
    "@vercel/blob": "^2.9.0",
    "convex": "1.49.0",
    "express": "^5.3.0",
    "lucide-react": "^1.67.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
