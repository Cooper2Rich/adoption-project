import { internalMutation as mutation } from "./functions.ts";
import { v } from "convex/values";

// Copied only into a run-owned local deployment. Never part of application functions.
export const seed = mutation({
  args: { runId: v.string() },
  handler: async (ctx, { runId }) => {
    for (const [slug, nonprofitId, subject] of [
      ["adoption", "nonprofit-a", "manager-a"],
      ["other", "nonprofit-b", "manager-b"],
    ]) {
      const existing = await ctx.db
        .query("campaigns")
        .withIndex("by_slug", (q) => q.eq("slug", slug))
        .unique();
      if (existing)
        throw new Error("Fixture data already exists; refuse to overwrite it");
      await ctx.db.insert("campaigns", {
        slug,
        nonprofitId,
        name: slug === "adoption" ? "adoption.is" : "Isolation control",
        fixtureRunId: runId,
        authority: {
          revision: "authority-1",
          dailyLimitCents: 10000,
          totalLimitCents: 10000,
          dailyCommittedCents: 0,
          campaignCommittedCents: 0,
          capacity: 4,
        },
        reservationFundingCents: 0,
        reservedSlots: 0,
        reservedCents: 0,
        reservationFinanceRevision: "finance-1",
      });
      await ctx.db.insert("memberships", {
        subject,
        nonprofitId,
        role: "manager",
        active: true,
      });
      await ctx.db.insert("memberships", {
        subject: `creator-${slug}`,
        nonprofitId,
        role: "creator",
        active: true,
      });
      for (const kind of ["provider", "finance"] as const)
        await ctx.db.insert("campaignResources", {
          campaignSlug: slug,
          nonprofitId,
          kind,
          reference: `unvalidated-fixture-${kind}-${nonprofitId}`,
        });
    }
    for (const control of [
      { slug: "slot-control", capacity: 1, fundingCents: 2000 },
      { slug: "fund-control", capacity: 2, fundingCents: 1000 },
    ]) {
      await ctx.db.insert("campaigns", {
        slug: control.slug,
        nonprofitId: "nonprofit-a",
        name: "Reservation verification only",
        fixtureRunId: runId,
        authority: {
          revision: "authority-1",
          dailyLimitCents: control.fundingCents,
          totalLimitCents: control.fundingCents,
          dailyCommittedCents: 0,
          campaignCommittedCents: 0,
          capacity: control.capacity,
        },
        reservationFundingCents: control.fundingCents,
        reservedSlots: 0,
        reservedCents: 0,
        reservationFinanceRevision: "finance-1",
      });
      for (const entryId of ["candidate-a", "candidate-b"])
        await ctx.db.insert("reservationCandidates", {
          campaignSlug: control.slug,
          entryId,
          authorized: true,
          amountCents: 1000,
        });
    }
    await ctx.db.insert("operators", {
      subject: "administrator",
      active: true,
    });
  },
});

export const resourceIds = mutation({
  args: { campaignSlug: v.string() },
  handler: async (ctx, { campaignSlug }) =>
    (
      await ctx.db
        .query("campaignResources")
        .withIndex("by_campaign", (q) => q.eq("campaignSlug", campaignSlug))
        .collect()
    ).map((row) => row._id),
});

export const changeAuthority = mutation({
  args: { campaignSlug: v.string(), revision: v.string() },
  handler: async (ctx, args) => {
    const campaign = await ctx.db
      .query("campaigns")
      .withIndex("by_slug", (q) => q.eq("slug", args.campaignSlug))
      .unique();
    if (!campaign) throw new Error("Fixture campaign not found");
    await ctx.db.patch(campaign._id, {
      authority: { ...campaign.authority, revision: args.revision },
    });
  },
});

export const revoke = mutation({
  args: { subject: v.string(), nonprofitId: v.string() },
  handler: async (ctx, args) => {
    const membership = await ctx.db
      .query("memberships")
      .withIndex("by_subject_nonprofit", (q) =>
        q.eq("subject", args.subject).eq("nonprofitId", args.nonprofitId),
      )
      .unique();
    if (!membership) throw new Error("Fixture membership not found");
    await ctx.db.patch(membership._id, { active: false });
  },
});

export const terms = mutation({
  args: { campaignSlug: v.string(), synthetic: v.literal(true) },
  handler: async (ctx, { campaignSlug, synthetic }) => {
    const campaign = await ctx.db
      .query("campaigns")
      .withIndex("by_slug", (q) => q.eq("slug", campaignSlug))
      .unique();
    if (
      !campaign ||
      campaign.fixtureRunId !== process.env.ALLOCATION_PREVIEW_FIXTURE_RUN_ID
    )
      throw new Error("Owned fixture required");
    if (
      await ctx.db
        .query("participationTerms")
        .withIndex("by_campaign", (q) => q.eq("campaignSlug", campaignSlug))
        .unique()
    )
      throw new Error("Fixture terms already configured");
    return await ctx.db.insert("participationTerms", {
      campaignSlug,
      nonprofitId: campaign.nonprofitId,
      version: "synthetic-test-v1",
      title: "SYNTHETIC TEST AGREEMENT — NOT LEGAL TERMS",
      body: "SYNTHETIC ISOLATED VERIFICATION ONLY. This text is not an applicable legal agreement and must never enable production signup.\nTest coverage: commission, prizes, score, cutoffs, refunds and creative use.\nTest permission model: creators retain ownership and confirm permission to authorize included content. Campaign submissions may be publicly displayed and used for campaign advertising without additional approval per submission or placement. New advertising use ends on withdrawal or campaign completion. Private records remain available to explain results and payments.\nActual legal matters require a supplied, approved pre-signup use agreement.",
      synthetic,
      approvedBy: "synthetic-fixture-operator",
      approvedAt: Date.now(),
    });
  },
});
export const privateRecords = mutation({
  args: { campaignSlug: v.string(), subject: v.string() },
  handler: async (ctx, { campaignSlug, subject }) => {
    const campaign = await ctx.db
      .query("campaigns")
      .withIndex("by_slug", (q) => q.eq("slug", campaignSlug))
      .unique();
    if (
      !campaign ||
      campaign.fixtureRunId !== process.env.ALLOCATION_PREVIEW_FIXTURE_RUN_ID
    )
      throw new Error("Owned fixture required");
    const ids = [];
    for (const kind of ["earnings", "payment-setup"] as const)
      ids.push(
        await ctx.db.insert("creatorPrivateRecords", {
          campaignSlug,
          nonprofitId: campaign.nonprofitId,
          subject,
          kind,
          summary: `Synthetic private ${kind} for ${subject}`,
        }),
      );
    return ids;
  },
});
export const removeFixtureScope = mutation({
  args: { campaignSlug: v.string() },
  handler: async (ctx, { campaignSlug }) => {
    const campaign = await ctx.db
      .query("campaigns")
      .withIndex("by_slug", (q) => q.eq("slug", campaignSlug))
      .unique();
    if (
      !campaign ||
      campaign.fixtureRunId !== process.env.ALLOCATION_PREVIEW_FIXTURE_RUN_ID
    )
      throw new Error("Owned fixture required");
    await ctx.db.patch(campaign._id, { fixtureRunId: undefined });
  },
});

export const removeTerms = mutation({
  args: { campaignSlug: v.string() },
  handler: async (ctx, { campaignSlug }) => {
    const terms = await ctx.db
      .query("participationTerms")
      .withIndex("by_campaign", (q) => q.eq("campaignSlug", campaignSlug))
      .unique();
    if (terms) await ctx.db.delete(terms._id);
  },
});
export const foreignPrivateRecord = mutation({
  args: { subject: v.string() },
  handler: async (ctx, { subject }) =>
    await ctx.db.insert("creatorPrivateRecords", {
      campaignSlug: "adoption",
      nonprofitId: "nonprofit-b",
      subject,
