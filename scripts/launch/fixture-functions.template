export const paidControl = mutation({
  args:{campaignId:v.string(),now:v.optional(v.union(v.number(),v.null())),subject:v.optional(v.string()),active:v.optional(v.boolean()),coverageId:v.optional(v.id("paidCoverage"))},
  handler:async(ctx,args)=>{
