    if(!campaign?.fixtureRunId||campaign.fixtureRunId!==process.env.ALLOCATION_PREVIEW_FIXTURE_RUN_ID)throw new Error("Owned fixture required");
    if(args.now!==undefined){if(args.now!==null&&(!Number.isSafeInteger(args.now)||args.now>Date.now()+30_000))throw new Error("Owned clock out of range");await ctx.db.patch(campaign._id,{fixturePaidNow:args.now??undefined});}
    if(args.subject&&args.active!==undefined){const m=await ctx.db.query("memberships").withIndex("by_subject_nonprofit",q=>q.eq("subject",args.subject!).eq("nonprofitId",campaign.nonprofitId)).unique();if(!m)throw new Error("Owned membership required");await ctx.db.patch(m._id,{active:args.active});}
