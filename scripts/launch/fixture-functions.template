  await ctx.db.insert("campaigns", { ...record, slug, name: "Owned zero prize verification", reservedSlots: 0, reservedCents: 0, reservationFundingCents: 0 });
} });
import { recordTrustedCommissionObligation,recordTrustedCommissionPayment,recordTrustedFinalizedFundraising,recordTrustedFundraisingPeriod } from "./fundraisingCorrections.ts";
